{
  "name": "where-to-go",
  "version": "0.1.0",
  "private": true,
  "description": "Global experience intelligence platform. Find your kind of night.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard:market": "node scripts/guard-market-literals.mjs",
    "db:check": "node --env-file=.env.local scripts/check-db.mjs",
    "db:status": "node --env-file=.env.local scripts/migrate.mjs --status",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:verify": "node --env-file=.env.local scripts/verify-market-rules.mjs",
    "verify": "npm run typecheck && npm run lint && npm run guard:market && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "drizzle-orm": "^0.45.4",
    "luxon": "^3.7.2",
    "next": "^16.4.3",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
