# Where to Go — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored (.env.* in .gitignore).
# NEVER commit real values. NEVER paste a secret into chat, a doc, or a commit.
#
# Where each value comes from, in the Supabase dashboard for your project:
#   Project Settings -> API         -> project URL and publishable/anon key
#   Project Settings -> API         -> service_role key  (reveal once, treat as a password)
#   Project Settings -> Database    -> connection strings
#
# ---------------------------------------------------------------------------
# Supabase: client-safe values
# ---------------------------------------------------------------------------
# Safe to expose to the browser. Protected by row-level security, which is a
# second line of defence only — every write is still authorized server-side
# (ADR-002).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# ---------------------------------------------------------------------------
# Supabase: server-only secrets
# ---------------------------------------------------------------------------
# Bypasses row-level security entirely. Server-side only.
# Must never be prefixed NEXT_PUBLIC_, never imported into a client component,
# never logged.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ---------------------------------------------------------------------------
# Database connections
# ---------------------------------------------------------------------------
# App runtime: transaction pooler, port 6543. Pooled, no prepared statements.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:6543/postgres

# Migrations and type generation: direct connection, port 5432.
# Pooled connections cannot run DDL reliably.
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Market defaults — configuration, never constants (ADR-009)
# ---------------------------------------------------------------------------
# The market a bare visit resolves to. Currency, timezone and locale are NOT
# set here: they are read from the market record at every call site. This is a
# routing default only, and shared business logic must not read it.
DEFAULT_MARKET_SLUG=dubai

# ---------------------------------------------------------------------------
# External providers — all stubbed until a spend cap is set (ADR-003, ADR-004)
# ---------------------------------------------------------------------------
# Leave as "stub". Setting a real provider without an agreed monthly cap and a
# kill switch is prohibited by CLAUDE.md and by the brief's D3.
MAPS_PROVIDER=stub
GEOCODING_PROVIDER=stub
LLM_PROVIDER=stub
# LLM_API_KEY=            # intentionally unset

# ---------------------------------------------------------------------------
# Ingestion safety — do not change without written approval
# ---------------------------------------------------------------------------
# Live collection is disabled by default (CLAUDE.md). Connectors run dry-run
# only; the fixture connector is the only one permitted before Phase 5.
INGESTION_ENABLED=false
INGESTION_DRY_RUN=true
INGESTION_KILL_SWITCH=true

# ---------------------------------------------------------------------------
# Fixtures
# ---------------------------------------------------------------------------
# Fictional seed data is clearly labelled as demo in the UI and must never be
# presented as real venues. Fixture dates are generated relative to this clock
# so the suite does not rot; leave unset to use the real current time.
SEED_DEMO_DATA=true
# FIXTURE_CLOCK=2026-10-26T12:00:00Z
